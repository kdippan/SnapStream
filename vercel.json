{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "snapstream-lake.vercel.app" }],
      "destination": "https://snapstream.dippan.com.np/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "snapstream.dippanbhusal.tech" }],
      "destination": "https://snapstream.dippan.com.np/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/offline", "destination": "/offline.html" },
    { "source": "/api/contact", "destination": "/api/contact.js" }
  ],
  "headers": [
    {
      "source": "/(.*).(jpg|jpeg|png|svg|ico|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
